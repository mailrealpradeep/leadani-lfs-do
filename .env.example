# ============================================================
# Server
# ============================================================
PORT=5000
NODE_ENV=development

# ============================================================
# Database (required in production — app refuses to start without it)
# For DigitalOcean Managed Postgres include sslmode=require in the URL.
# ============================================================
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Max connections in the pg pool (default 10; keep below your DB plan's limit)
# DB_POOL_MAX=10
# Optional: PEM CA certificate for full TLS verification (DO Managed PG CA)
# DATABASE_CA_CERT=

# ============================================================
# Secrets (set real values in production; defaults are public in the code)
# NOTE: when first setting these on an existing deployment, keep the current
# values in use — rotating JWT_SECRET logs out all users; rotating HMAC_SECRET
# breaks webhook signature verification.
# ============================================================
JWT_SECRET=your-jwt-secret-key-change-in-production
HMAC_SECRET=your-webhook-hmac-secret-key-change-in-production

# ============================================================
# CORS / frontend origin (Socket.io). Set to the app's public URL in prod.
# ============================================================
FRONTEND_URL=http://localhost:5000

# ============================================================
# Web Push (VAPID). Carry existing keys across deployments —
# regenerating them invalidates every stored push subscription.
# ============================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ============================================================
# Sarvam AI (LLM features). Can also be set per-company in app settings.
# ============================================================
SARVAM_API_KEY=

# ============================================================
# File storage: "local" (./uploads on disk) or "s3" (S3-compatible,
# e.g. DigitalOcean Spaces). Defaults to local.
# ============================================================
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://blr1.digitaloceanspaces.com
# S3_REGION=blr1
# S3_BUCKET=your-bucket-name
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ============================================================
# Google Sheets backup. If set, uses a Google service account
# (raw JSON or base64 of the service-account key file); users must share
# their sheets with the service account email as Editor.
# If unset, falls back to the Replit Google Sheets connector (Replit only).
# ============================================================
# GOOGLE_SERVICE_ACCOUNT_JSON=

# ============================================================
# Super-admin bootstrap account (created at boot if missing)
# ============================================================
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
