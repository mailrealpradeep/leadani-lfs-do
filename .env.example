# ============================================================
# Server
# ============================================================
PORT=5000
NODE_ENV=development

# ============================================================
# Database (required in production — app refuses to start without it)
# For DigitalOcean Managed Postgres include sslmode=require in the URL.
# ============================================================
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Max connections in the pg pool (default 10; keep below your DB plan's limit)
# DB_POOL_MAX=10
# Optional: PEM CA certificate for full TLS verification (DO Managed PG CA)
# DATABASE_CA_CERT=

# ============================================================
# Secrets (set real values in production; defaults are public in the code)
# NOTE: when first setting these on an existing deployment, keep the current
# values in use — rotating JWT_SECRET logs out all users; rotating HMAC_SECRET
# breaks webhook signature verification.
# ============================================================
JWT_SECRET=your-jwt-secret-key-change-in-production
HMAC_SECRET=your-webhook-hmac-secret-key-change-in-production

# ============================================================
# CORS / frontend origin (Socket.io). Set to the app's public URL in prod.
# ============================================================
FRONTEND_URL=http://localhost:5000

# ============================================================
# Web Push (VAPID). Carry existing keys across deployments —
# regenerating them invalidates every stored push subscription.
# ============================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ============================================================
# Sarvam AI (LLM features). Can also be set per-company in app settings.
# ============================================================
SARVAM_API_KEY=

# ============================================================
# File storage: "local" (./uploads on disk) or "s3" (S3-compatible,
# e.g. DigitalOcean Spaces). Defaults to local.
# ============================================================
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://blr1.digitaloceanspaces.com
# S3_REGION=blr1
# S3_BUCKET=your-bucket-name
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ============================================================
# Google Sheets backup. Uses a Google service account: set this to the key file
# as raw JSON or, preferably, base64 (the private key contains newlines that
# most environment-variable UIs mangle). Every backup spreadsheet must be shared
# with the service account address as Editor.
# Required outside Replit — the only other auth path is the Replit connector.
# ============================================================
# GOOGLE_SERVICE_ACCOUNT_JSON=

# ============================================================
# Super-admin bootstrap account (created at boot if missing)
# ============================================================
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=

# ============================================================
# Outbound integrations kill switch.
#
# Set to "disabled" on ANY deployment that is not the one serving real users
# (staging, rehearsal, a local run against a production restore). The database
# dump carries live third-party credentials — Wauper WhatsApp access tokens and
# 12 enabled Google Sheets backup targets — so a second deployment booted with
# them active messages real leads and overwrites the real backup spreadsheets.
#
# Suppresses: WhatsApp sends, outgoing webhooks, Google Sheets backups, web
# push. Inbound traffic, the UI and the database are unaffected. Each suppressed
# call logs one `[outbound:blocked]` line.
#
# Default "enabled" — production needs no extra variable.
# ============================================================
# OUTBOUND_INTEGRATIONS=disabled

# ============================================================
# Log retention (days) for activity_logs, audit_logs,
# outgoing_webhook_logs and webhook_requests. These four have no retention of
# their own and are ~2.1 GB of a 2.7 GB production database. Pruned daily in
# batches. Set to 0 to keep everything forever.
# ============================================================
# LOG_RETENTION_DAYS=90
